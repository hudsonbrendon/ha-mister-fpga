          "name": "ID da entrada",
          "description": "ID da config entry do MiSTer alvo."
        }
      }
    },
    "run_script": {
      "name": "Executar script",
      "description": "Executa um script da pasta Scripts do MiSTer.",
      "fields": {
        "entry_id": {
          "name": "ID da entrada",
          "description": "ID da config entry do MiSTer alvo."
        },
        "filename": {
          "name": "Arquivo",
          "description": "Nome do script, ex.: update_all.sh."
        }
      }
    },
    "launch": {
      "name": "Iniciar",
      "description": "Inicia qualquer jogo, core, .mra ou .mgl pelo caminho absoluto.",
      "fields": {
        "entry_id": {
          "name": "ID da entrada",
          "description": "ID da config entry do MiSTer alvo."
        },
        "path": {
          "name": "Caminho",
          "description": "Caminho absoluto do arquivo."
        }
      }
    },
    "launch_token": {
      "name": "Iniciar token",
      "description": "Inicia um token em texto puro, como gravado numa tag NFC ou QR code: um caminho ou um comando como **random:snes.",
      "fields": {
        "entry_id": {
          "name": "ID da entrada",
          "description": "ID da config entry do MiSTer alvo."
        },
        "data": {
          "name": "Dados",
          "description": "Texto do token, ex.: **random:snes ou _Console/SNES. A codificação é feita para você."
        }
      }
    },
    "set_ini_value": {
      "name": "Definir valor do INI",
      "description": "Define uma chave no MiSTer.ini ativo.",
      "fields": {
        "entry_id": {
          "name": "ID da entrada",
          "description": "ID da config entry do MiSTer alvo."
        },
        "key": {
          "name": "Chave",
          "description": "Chave do MiSTer.ini, ex.: vga_scaler."
        },
        "value": {
          "name": "Valor",
          "description": "Valor a definir (string vazia remove a chave)."
        }
      }
    },
    "set_wallpaper": {
      "name": "Definir wallpaper",
      "description": "Define o wallpaper ativo do menu pelo nome do arquivo.",
      "fields": {
        "entry_id": {
          "name": "ID da entrada",
          "description": "ID da config entry do MiSTer alvo."
        },
        "filename": {
          "name": "Arquivo",
          "description": "Nome do arquivo de wallpaper."
        }
      }
    },
    "set_background_mode": {
      "name": "Definir modo de fundo",
      "description": "Define o modo de fundo do menu: 0 nenhum, 2 wallpaper, 4/6 barras horizontais, 8/10 barras verticais, 12 espectro, 14 preto.",
      "fields": {
        "entry_id": {
          "name": "ID da entrada",
          "description": "ID da config entry do MiSTer alvo."
        },
        "mode": {
          "name": "Modo",
          "description": "Valor par de 0 a 14."
        }
      }
    },
    "send_keyboard_raw": {
      "name": "Enviar tecla bruta",
      "description": "Envia um código uinput de teclado bruto ao MiSTer.",
      "fields": {
        "entry_id": {
          "name": "ID da entrada",
          "description": "ID da config entry do MiSTer alvo."
        },
        "code": {
          "name": "Código",
          "description": "Código uinput da tecla (0-255)."
        }
      }
    },
    "create_shortcut": {
      "name": "Criar atalho",
      "description": "Cria um atalho .mgl para um jogo e retorna o caminho.",
      "fields": {
        "entry_id": {
          "name": "ID da entrada",
          "description": "ID da config entry do MiSTer alvo."
        },
        "game_path": {
          "name": "Caminho do jogo",
          "description": "Caminho absoluto do arquivo do jogo."
        },
        "folder": {
          "name": "Pasta",
          "description": "Pasta de menu destino (ex.: _@Favorites)."
        },
        "name": {
          "name": "Nome",
          "description": "Nome do atalho (sem extensão)."
        }
      }
    },
    "delete_screenshot": {
      "name": "Apagar screenshot",
      "description": "Apaga um screenshot salvo.",
      "fields": {
        "entry_id": {
          "name": "ID da entrada",
          "description": "ID da config entry do MiSTer alvo."
        },
        "core": {
          "name": "Core",
          "description": "Pasta do core do screenshot, ex.: SNES."
        },
        "filename": {
          "name": "Arquivo",
          "description": "Nome do arquivo do screenshot."
        }
      }
    },
    "send_command": {
      "name": "Enviar comando ao MiSTer",
      "description": "Escreve um comando no FIFO /dev/MiSTer_cmd do Main via SSH (requer SSH). Falha em vez de travar quando o Main está travado.",
      "fields": {
        "entry_id": {
          "name": "ID da entrada",
          "description": "ID da config entry do MiSTer alvo."
        },
        "command": {
          "name": "Comando",
          "description": "ex.: load_core /media/fat/menu.rbf, volume 5, screenshot."
        }
      }
    },
    "gamepad_press": {
      "name": "Apertar botão do gamepad",
      "description": "Aperta um botão do controle virtual pelo daemon MiSTer Companion Remote.",
      "fields": {
        "entry_id": {
          "name": "ID da entrada",
          "description": "ID da config entry do MiSTer alvo."
        },
        "button": {
          "name": "Botão",
          "description": "Botão do controle ou direção do D-pad."
        },
        "action": {
          "name": "Ação",
          "description": "tap (toque curto), down ou up. Um botão segurado é solto quando a chamada termina."
        }
      }
    },
    "set_ra_debug": {
      "name": "Definir log de depuração do RetroAchievements",
      "description": "Liga ou desliga o log de depuração do RetroAchievements do odelot (requer SSH). Ele alimenta os eventos mister_fpga_retroachievements e vale a partir do próximo carregamento de core.",
      "fields": {
        "entry_id": {
          "name": "ID da entrada",
          "description": "ID da config entry do MiSTer alvo."
        },
        "enabled": {
          "name": "Ativado",
          "description": "Grava debug=1 (ligado) ou debug=0 (desligado) no retroachievements.cfg."
        }
      }
    }
  }
