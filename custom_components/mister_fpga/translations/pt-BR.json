  "services": {
    "launch_game": {
      "name": "Iniciar jogo",
      "description": "Inicia um jogo pelo caminho do arquivo no MiSTer.",
      "fields": {
        "entry_id": {
          "name": "ID da entrada",
          "description": "ID da config entry do MiSTer alvo."
        },
        "path": {
          "name": "Caminho",
          "description": "Caminho absoluto do arquivo do jogo."
        }
      }
    },
    "launch_system": {
      "name": "Iniciar sistema",
      "description": "Inicia um core/sistema pelo ID.",
