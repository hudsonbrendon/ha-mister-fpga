{
  "config": {
    "step": {
      "user": {
        "title": "MiSTer FPGA",
        "description": "Connect to the mrext Remote service running on your MiSTer.",
        "data": {
          "name": "Name",
          "host": "Host or IP address",
          "port": "Port"
        }
      },
      "zeroconf_confirm": {
        "title": "MiSTer FPGA",
        "description": "Add the MiSTer {name} found at {host}?"
      }
    },
    "error": {
      "cannot_connect": "Failed to connect. Check the IP and that the Remote service is running on the MiSTer."
    },
    "abort": {
      "already_configured": "This MiSTer is already configured."
    },
    "flow_title": "{name}"
  },
  "options": {
    "step": {
      "init": {
        "title": "MiSTer FPGA options",
        "data": {
          "scan_interval": "Scan interval (seconds)",
          "ssh_enabled": "Enable SSH telemetry",
          "ssh_username": "SSH username",
          "ssh_password": "SSH password",
          "ssh_port": "SSH port",
          "ra_username": "RetroAchievements username",
          "ra_api_key": "RetroAchievements Web API key",
          "ra_cloud_interval": "RetroAchievements poll interval (seconds)",
          "push_updates": "Instant game updates (needs SSH)",
          "gamepad_enabled": "Gamepad buttons (Companion Remote)"
        },
        "data_description": {
          "push_updates": "Writes announce_game_url to /media/fat/Scripts/remote.ini over SSH so the Remote pushes every game change to a local Home Assistant webhook, then restarts the Remote.",
          "gamepad_enabled": "Adds gamepad buttons and the gamepad_press action when the MiSTer Companion Remote daemon (port 9191) answers."
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid RetroAchievements credentials"
    }
  },
