  "services": {
    "launch_game": {
      "name": "Launch game",
      "description": "Launch a game by its file path on the MiSTer.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "path": {
          "name": "Path",
          "description": "Absolute path of the game file."
        }
      }
    },
    "launch_system": {
      "name": "Launch system",
      "description": "Launch a core/system by its ID.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "system_id": {
          "name": "System ID",
          "description": "System/core ID, e.g. SNES."
        }
      }
    },
    "search_games": {
      "name": "Search games",
      "description": "Search indexed games and return the results.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "query": {
          "name": "Query",
          "description": "Search text."
        },
        "system": {
          "name": "System",
          "description": "Restrict to a system ID (default: all)."
        },
        "page": {
          "name": "Page",
          "description": "1-based result page (Remote 0.5 paginates)."
        }
      }
    },
    "send_keyboard": {
      "name": "Send keyboard",
      "description": "Send a named keyboard key to the MiSTer.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "key": {
          "name": "Key",
          "description": "Key name, e.g. up, down, enter, escape."
        }
      }
    },
    "take_screenshot": {
      "name": "Take screenshot",
      "description": "Trigger a screenshot capture on the MiSTer.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        }
      }
    },
    "run_script": {
      "name": "Run script",
      "description": "Launch a script from the MiSTer Scripts folder.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "filename": {
          "name": "Filename",
          "description": "Script filename, e.g. update_all.sh."
        }
      }
    },
    "launch": {
      "name": "Launch",
      "description": "Launch any game, core, .mra or .mgl by absolute path.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "path": {
          "name": "Path",
          "description": "Absolute path to the file to launch."
        }
      }
    },
    "launch_token": {
      "name": "Launch token",
      "description": "Launch a token in plain text, as written to an NFC tag or QR code: a path or a command such as **random:snes.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "data": {
          "name": "Data",
          "description": "Token text, e.g. **random:snes or _Console/SNES. Encoded for you."
        }
      }
    },
    "set_ini_value": {
      "name": "Set INI value",
      "description": "Set a key in the active MiSTer.ini file.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "key": {
          "name": "Key",
          "description": "MiSTer.ini key, e.g. vga_scaler."
        },
        "value": {
          "name": "Value",
          "description": "Value to set (empty string removes the key)."
        }
      }
    },
    "set_wallpaper": {
      "name": "Set wallpaper",
      "description": "Set the active menu wallpaper by filename.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "filename": {
          "name": "Filename",
          "description": "Wallpaper filename."
        }
      }
    },
    "set_background_mode": {
      "name": "Set background mode",
      "description": "Set the menu background mode: 0 none, 2 wallpaper, 4/6 horizontal bars, 8/10 vertical bars, 12 spectrum, 14 black.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "mode": {
          "name": "Mode",
          "description": "Even value 0-14."
        }
      }
    },
    "send_keyboard_raw": {
      "name": "Send raw keyboard",
      "description": "Send a raw uinput keyboard code to the MiSTer.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "code": {
          "name": "Code",
          "description": "uinput key code (0-255)."
        }
      }
    },
    "create_shortcut": {
      "name": "Create shortcut",
      "description": "Create an .mgl shortcut for a game and return its path.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "game_path": {
          "name": "Game path",
          "description": "Absolute path to the game file."
        },
        "folder": {
          "name": "Folder",
          "description": "Destination menu folder (e.g. _@Favorites)."
        },
        "name": {
          "name": "Name",
          "description": "Shortcut name (without extension)."
        }
      }
    },
    "delete_screenshot": {
      "name": "Delete screenshot",
      "description": "Delete one saved screenshot.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "core": {
          "name": "Core",
          "description": "Core folder of the screenshot, e.g. SNES."
        },
        "filename": {
          "name": "Filename",
          "description": "Screenshot filename."
        }
      }
    },
    "send_command": {
      "name": "Send MiSTer command",
      "description": "Write one command to Main's /dev/MiSTer_cmd FIFO over SSH (needs SSH). Fails instead of hanging when Main is stuck.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "command": {
          "name": "Command",
          "description": "e.g. load_core /media/fat/menu.rbf, volume 5, screenshot."
        }
      }
    },
    "gamepad_press": {
      "name": "Gamepad press",
      "description": "Press a virtual controller button through the MiSTer Companion Remote daemon.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "button": {
          "name": "Button",
          "description": "Controller button or D-pad direction."
        },
        "action": {
          "name": "Action",
          "description": "tap (short press), down or up. A held button is released when the call ends."
        }
      }
    },
    "set_ra_debug": {
      "name": "Set RetroAchievements debug log",
      "description": "Turn odelot's RetroAchievements debug log on or off (needs SSH). It feeds the mister_fpga_retroachievements events and applies on the next core load.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID of the target MiSTer."
        },
        "enabled": {
          "name": "Enabled",
          "description": "Write debug=1 (on) or debug=0 (off) to retroachievements.cfg."
        }
      }
    }
  }
}
